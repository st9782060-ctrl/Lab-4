#include <iostream>
#include <iomanip>

using namespace std;

int main() {
    double v1, v2, v3, v4, v5;

    cout << "Enter 5 numbers (e.g. 2.3 2.3 2.123456 2.123456 2.123456): ";
    cin >> v1 >> v2 >> v3 >> v4 >> v5;

    cout << "\nResult:" << endl;
    cout << v1 << endl;
    cout << fixed << setprecision(2) << v2 << endl;
    cout << setprecision(6) << v3 << endl;
    cout << setprecision(2) << v4 << endl;
    cout << (int)v5 << endl;

    system("pause");
    return 0;
}
