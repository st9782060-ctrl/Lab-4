#include <iostream>

using namespace std;

int main() {
    int n1, n2, n3, n4;

    cout << "Enter 4 numbers from 1 to 255 separated by space (e.g. 4 2 255 212): ";
    cin >> n1 >> n2 >> n3 >> n4;

    if (n1 >= 1 && n1 <= 255 &&
        n2 >= 1 && n2 <= 255 &&
        n3 >= 1 && n3 <= 255 &&
        n4 >= 1 && n4 <= 255) {
        cout << "IP address: " << n1 << "." << n2 << "." << n3 << "." << n4 << endl;
    } else {
        cout << "Error: Invalid IP address numbers (must be between 1 and 255)." << endl;
    }

    system("pause");
    return 0;
}
